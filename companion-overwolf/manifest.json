{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "NE Broadcast Suite Relay",
    "author": "Armour Studios",
    "version": "0.2.0",
    "minimum-overwolf-version": "0.240.0",
    "description": "Relays Overwatch, Marvel Rivals and Rainbow Six Siege live game data to NE Broadcast Suite",
    "icon": "icon.png"
  },
  "permissions": [
    "GameInfo",
    "Hotkeys",
    "Extensions"
  ],
  "data": {
    "start_window": "background",
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true,
        "block_top_window_navigation": true
      }
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [
        10844,
        24890
      ]
    },
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [
            10844,
            24890
          ]
        },
        "start_minimized": true
      }
    ]
  }
}
