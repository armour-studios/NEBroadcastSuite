# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.
#
# These values are baked into the official build by Armour Studios.
# End users of the pre-built installer do NOT need to configure anything here —
# the credentials are already included in the distributed EXE.

# ── Bug Reports ───────────────────────────────────────────────────────────────
# Discord webhook that receives in-app bug reports.
BUG_REPORT_WEBHOOK=

# Optional: also file each in-app bug report / feature request as a real GitHub Issue.
# Needs a Personal Access Token with "Issues: write" on the target repo (fine-grained PAT,
# repo scope) — dev-only, never bundled into distributed builds (not in gen-prod-env.js's
# PUBLIC_KEYS). GITHUB_REPO defaults to armour-studios/NEBroadcastSuite if left blank.
GITHUB_TOKEN=
GITHUB_REPO=

# ── Twitch Integration ────────────────────────────────────────────────────────
# Armour Studios' registered Twitch application (dev.twitch.tv/console).
# End users authenticate with their own Twitch account through the app UI —
# these are the app credentials, not the end user's credentials.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Signing secret for Twitch EventSub webhook payloads (any random string, 10-100 chars).
TWITCH_WEBHOOK_SECRET=
EVENTSUB_WEBHOOK_SECRET=

# ── Tracker.gg (no API key required) ─────────────────────────────────────────
# RL rank lookups use Electron's built-in browser to load tracker.gg — this
# bypasses Cloudflare automatically with no API key needed.
# TRACKERGG_API_KEY is unused and reserved for future non-RL game support.
TRACKERGG_API_KEY=

# ── Code Signing (build machine only) ────────────────────────────────────────
# Microsoft Trusted Signing — only needed when running: npm run build
# Leave blank for local dev (signing is skipped automatically).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
